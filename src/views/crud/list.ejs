<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <div class="container mt-5">
        <h1>Product List</h1>
        <a href="/product/create" class="btn btn-info">Add Product</a> ||
        <a href="/" class="btn btn-warning">Recovery Product</a>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th scope="col">Sl.No</th>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Price</th>
                    <th scope="col">Description</th>
                    <th scope="col">Brand</th>
                    <th scope="col">Image</th>
                    <th scope="col" colspan="3">Action</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach((item, index)=> { %>
                    <tr>
                        <th scope="row">
                            <%= index + 1 %>
                        </th>
                        <td>
                            <%= item._id.toString().slice(-5) %>
                        </td>
                        <td>
                            <%= item.name %>
                        </td>
                        <td>
                            <%= item.price %>
                        </td>
                        <td>
                            <%= item.description %>
                        </td>
                        <td>
                            <%= item.brand %>
                        </td>
                        <td>
                            <% const imgSrc=item.image && item.image.startsWith('http') ? item.image : '/uploads/' +
                                item.image; %>
                                <img src="<%= imgSrc %>" width="50" height="50" alt="<%= item.name %>">
                        </td>
                        <td><a href="#" class="btn btn-primary">Edit</a></td>
                        <td><a href="#" class="btn btn-success">View</a></td>
                        <td><a href="#" class="btn btn-danger">Delete</a></td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>